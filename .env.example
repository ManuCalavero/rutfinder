# Copia este archivo como .env y rellena los valores. El archivo .env NO se sube a git.

# Conexión a PostgreSQL
DATABASE_URL=postgres://localhost:5432/rutfinder_mvp

# Secreto para firmar las sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Primer administrador. Solo se usa al arrancar si todavía no existe ningún administrador;
# después, los datos y la contraseña se cambian desde el panel.
# La contraseña debe tener entre 12 y 72 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# En producción (Render) debe ser "production": activa las cookies seguras (solo HTTPS).
NODE_ENV=development
PORT=3000
