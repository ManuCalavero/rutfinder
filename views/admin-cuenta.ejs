<%- include('partials/head') %>
<h1>Mi cuenta</h1>
<div class="grid">
  <form method="post" action="/admin/cuenta/perfil" class="box box-pad">
    <h2>Datos</h2>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label for="name">Nombre</label>
    <input id="name" name="name" type="text" value="<%= profile.name %>" maxlength="100" autocomplete="name" required>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= profile.email %>" maxlength="254" autocomplete="email" required>
    <label for="organization">Organización</label>
    <input id="organization" name="organization" type="text" value="<%= profile.organization %>" maxlength="150" autocomplete="organization" required>
    <button type="submit" class="btn btn-primary btn-block">Guardar</button>
  </form>

  <form method="post" action="/admin/cuenta/password" class="box box-pad" id="password">
    <h2>Contraseña</h2>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label for="current">Actual</label>
    <input id="current" name="current" type="password" autocomplete="current-password" required>
    <label for="new-password">Nueva</label>
    <input id="new-password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required>
    <label for="repeat">Repite la nueva</label>
    <input id="repeat" name="repeat" type="password" minlength="12" maxlength="72" autocomplete="new-password" required>
    <button type="submit" class="btn btn-primary btn-block">Cambiar contraseña</button>
  </form>
</div>
<%- include('partials/foot') %>
