<%- include('partials/head') %>
<% const nuevos = preview.rows.filter((r) => !r.id).length; const sobrescritos = preview.rows.length - nuevos; %>
<div class="page-head">
  <div>
    <h1>Vista previa</h1>
    <p class="muted"><%= nuevos %> <%= nuevos === 1 ? 'nuevo' : 'nuevos' %> · <%= sobrescritos %> <%= sobrescritos === 1 ? 'se sobrescribe' : 'se sobrescriben' %><% if (preview.skipped) { %> · <%= preview.skipped %> sin nombre<% } %></p>
  </div>
  <div class="actions">
    <form method="post" action="/admin/productos/importar/cancelar">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <button type="submit" class="btn">Cancelar</button>
    </form>
    <form method="post" action="/admin/productos/importar/confirmar">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <button type="submit" class="btn btn-primary">Guardar</button>
    </form>
  </div>
</div>
<details class="box box-pad disclosure">
  <summary><%= preview.fields.length %> campos</summary>
  <ul><% preview.fields.forEach((f) => { %><li><%= f %></li><% }) %></ul>
</details>
<div class="box table-wrap">
  <table data-sortable>
    <thead>
      <tr><th scope="col" data-sort>Nombre</th><th scope="col" class="hide-sm" data-sort>Productor</th><th scope="col" class="hide-sm" data-sort>País</th><th scope="col"><span class="sr-only">Acción</span></th></tr>
    </thead>
    <tbody>
      <% preview.rows.forEach((r) => { %>
        <tr>
          <th scope="row"><%= r.name %></th>
          <td class="hide-sm cell-clip" data-value="<%= r.data['Producer'] || '' %>"><%= r.data['Producer'] || 'Sin datos' %></td>
          <td class="hide-sm" data-value="<%= r.data['Production location'] ? countries_text(r.data['Production location']) : '' %>"><%= countries_text(r.data['Production location']) %></td>
          <td class="cell-actions"><span class="badge<%= r.id ? ' badge-red' : '' %>"><%= r.id ? 'Se sobrescribe' : 'Nuevo' %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/foot') %>
