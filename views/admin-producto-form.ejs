<%- include('partials/head') %>
<% const back = product.id ? `/productos/${product.id}` : '/admin/productos'; %>
<a class="back" href="<%= back %>"><%- icon('back') %> <%= product.id ? 'Ficha' : 'Productos' %></a>
<h1><%= product.id ? 'Editar ficha' : 'Nuevo producto' %></h1>
<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
<% if (!groups.length) { %>
  <div class="flash flash-warn" role="status">No hay campos. Importa el Excel desde <a href="/admin/productos">Productos</a>.</div>
<% } %>
<form method="post" action="<%= product.id ? `/admin/productos/${product.id}` : '/admin/productos' %>">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <div class="product-layout">
    <div class="sections">
      <div class="box section">
        <label for="name">Nombre</label>
        <input id="name" name="name" type="text" value="<%= product.name %>" maxlength="300" required>
      </div>
      <%- include('partials/standards-form', { product, std, suggestions, sources }) %>
      <% groups.forEach((g) => { %>
        <section class="box section" id="<%= g.id %>" aria-labelledby="t-<%= g.id %>">
          <h2 id="t-<%= g.id %>"><%- icon(g.id) %><%= g.title %></h2>
          <div class="fields">
            <% g.items.forEach((i) => { const lines = i.value.split('\n').length + Math.ceil(i.value.length / 90); %>
              <div class="field<%= i.half ? ' field-half' : '' %>">
                <label for="f<%= i.index %>"><%= i.label %></label>
                <textarea id="f<%= i.index %>" name="f<%= i.index %>" rows="<%= Math.min(14, Math.max(2, lines)) %>"><%= i.value %></textarea>
              </div>
            <% }) %>
          </div>
        </section>
      <% }) %>
      <div class="form-bar">
        <button type="submit" class="btn btn-primary"><%= product.id ? 'Guardar' : 'Crear producto' %></button>
        <a class="btn" href="<%= back %>">Cancelar</a>
      </div>
    </div>
    <%- include('partials/toc', { groups: [{ id: 'standards', title: 'Normas', filled: std.hasData }, ...groups] }) %>
  </div>
</form>
<%- include('partials/foot') %>
