<%- include('partials/head') %>
<% const filtered = search || country || state !== 'all'; %>
<div class="page-head">
  <h1>Productos</h1>
  <div class="actions">
    <details class="dropdown" <%= openImport ? 'open' : '' %>>
      <summary class="btn"><%- icon('upload') %>Importar Excel</summary>
      <form method="post" action="/admin/productos/importar" enctype="multipart/form-data" class="dropdown-panel">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <input name="archivo" type="file" accept=".xlsx" aria-label="Archivo Excel" required>
        <button type="submit" class="btn btn-primary btn-block">Ver vista previa</button>
      </form>
    </details>
    <a class="btn btn-primary" href="/admin/productos/nuevo"><%- icon('plus') %>Nuevo producto</a>
  </div>
</div>

<% if (pendingImport) { %>
  <div class="flash flash-warn" role="status">Hay una importación sin confirmar. <a href="/admin/productos/importar">Revisar</a></div>
<% } %>

<form method="get" action="/admin/productos" class="filters" role="search">
  <input name="q" type="search" value="<%= search %>" maxlength="100" placeholder="Buscar" aria-label="Buscar">
  <select name="pais" aria-label="País de producción">
    <option value="">Todos los países</option>
    <% countries.forEach((c) => { %><option value="<%= c %>" <%= c === country ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <select name="estado" aria-label="Estado">
    <option value="">Visibles y ocultos</option>
    <option value="visible" <%= state === 'visible' ? 'selected' : '' %>>Visibles</option>
    <option value="hidden" <%= state === 'hidden' ? 'selected' : '' %>>Ocultos</option>
  </select>
  <button type="submit" class="btn">Filtrar</button>
  <% if (filtered) { %><a class="link" href="/admin/productos">Limpiar</a><% } %>
</form>

<% if (!products.length) { %>
  <div class="box blankslate"><p><%= filtered ? 'Ningún producto coincide.' : 'Todavía no hay productos.' %></p></div>
<% } else { %>
  <div class="box table-wrap">
    <table data-sortable>
      <thead>
        <tr><th scope="col" data-sort aria-sort="ascending">Nombre</th><th scope="col" class="hide-sm" data-sort>Productor</th><th scope="col" class="hide-sm" data-sort>País</th><th scope="col"><span class="sr-only">Acciones</span></th></tr>
      </thead>
      <tbody>
        <% products.forEach((p) => { %>
          <tr>
            <th scope="row" data-value="<%= p.name %>"><a href="/productos/<%= p.id %>"><%= p.name %></a><% if (p.hidden) { %> <span class="badge badge-red">Oculto</span><% } %></th>
            <td class="hide-sm cell-clip" data-value="<%= p.producer || '' %>"><%= p.producer || 'Sin datos' %></td>
            <td class="hide-sm" data-value="<%= p.location ? countries_text(p.location) : '' %>"><%= countries_text(p.location) %></td>
            <td class="cell-actions">
              <a class="btn btn-sm" href="/admin/productos/<%= p.id %>/editar" aria-label="Editar <%= p.name %>">Editar</a>
              <% if (p.hidden) { %>
                <form method="post" action="/admin/productos/<%= p.id %>/mostrar">
                  <input type="hidden" name="_csrf" value="<%= csrf() %>">
                  <button type="submit" class="btn btn-sm" aria-label="Mostrar <%= p.name %>">Mostrar</button>
                </form>
              <% } else { %>
                <a class="btn btn-sm btn-danger" href="/admin/productos/<%= p.id %>/ocultar" aria-label="Ocultar <%= p.name %>">Ocultar</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/foot') %>
