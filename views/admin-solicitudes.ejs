<%- include('partials/head') %>
<h1>Solicitudes</h1>
<% if (!requests.length) { %>
  <div class="box blankslate"><p>No hay solicitudes pendientes.</p></div>
<% } else { %>
  <div class="box table-wrap">
    <table data-sortable>
      <thead>
        <tr><th scope="col" data-sort>Nombre</th><th scope="col" data-sort>Email</th><th scope="col" class="hide-sm" data-sort>Organización</th><th scope="col" class="hide-sm" data-sort aria-sort="ascending">Fecha</th><th scope="col"><span class="sr-only">Acciones</span></th></tr>
      </thead>
      <tbody>
        <% requests.forEach((r) => { %>
          <tr>
            <th scope="row"><%= r.name %></th>
            <td><%= r.email %></td>
            <td class="hide-sm"><%= r.organization %></td>
            <td class="hide-sm" data-value="<%= new Date(r.created_at).toISOString() %>"><%= fecha(r.created_at) %></td>
            <td class="cell-actions">
              <a class="btn btn-sm btn-danger" href="/admin/usuarios/<%= r.id %>/rechazar" aria-label="Rechazar a <%= r.name %>">Rechazar</a>
              <form method="post" action="/admin/usuarios/<%= r.id %>/aprobar">
                <input type="hidden" name="_csrf" value="<%= csrf() %>">
                <button type="submit" class="btn btn-sm btn-primary" aria-label="Aprobar a <%= r.name %>">Aprobar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/foot') %>
