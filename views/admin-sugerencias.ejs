<%- include('partials/head') %>
<h1>Sugerencias</h1>
<% if (!suggestions.length) { %>
  <div class="box blankslate"><p>No hay sugerencias sin revisar.</p></div>
<% } else { %>
  <div class="box table-wrap">
    <table data-sortable>
      <thead>
        <tr><th scope="col" data-sort>Producto</th><th scope="col">Enlace y notas</th><th scope="col" class="hide-sm" data-sort>De</th><th scope="col" class="hide-sm" data-sort aria-sort="ascending">Fecha</th><th scope="col"><span class="sr-only">Acciones</span></th></tr>
      </thead>
      <tbody>
        <% suggestions.forEach((s) => { %>
          <tr>
            <th scope="row" data-value="<%= s.name %>">
              <%= s.name || 'Sin nombre' %>
              <% if (s.producer || s.country) { %><small><%= [s.producer, s.country].filter(Boolean).join(' · ') %></small><% } %>
            </th>
            <td class="cell-wrap">
              <% if (s.url) { %><div><%- linkify(s.url) %></div><% } %>
              <% if (s.notes) { %><div class="pre"><%= s.notes %></div><% } %>
              <% if (!s.url && !s.notes) { %><span class="muted">Sin datos</span><% } %>
            </td>
            <td class="hide-sm" data-value="<%= s.user_name %>"><%= s.user_name %><small><%= s.user_org %></small></td>
            <td class="hide-sm" data-value="<%= new Date(s.created_at).toISOString() %>"><%= fecha(s.created_at) %></td>
            <td class="cell-actions">
              <form method="post" action="/admin/sugerencias/<%= s.id %>/revisada">
                <input type="hidden" name="_csrf" value="<%= csrf() %>">
                <button type="submit" class="btn btn-sm" aria-label="Marcar como revisada la sugerencia de <%= s.user_name %>">Revisada</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/foot') %>
