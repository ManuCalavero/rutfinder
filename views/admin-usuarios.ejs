<%- include('partials/head') %>
<div class="page-head">
  <h1>Usuarios</h1>
  <details class="dropdown" <%= openForm ? 'open' : '' %>>
    <summary class="btn btn-primary">Añadir usuario</summary>
    <form method="post" action="/admin/usuarios" class="dropdown-panel">
      <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <label for="name">Nombre</label>
      <input id="name" name="name" type="text" value="<%= values.name || '' %>" maxlength="100" autocomplete="off" required>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= values.email || '' %>" maxlength="254" autocomplete="off" required>
      <label for="organization">Organización</label>
      <input id="organization" name="organization" type="text" value="<%= values.organization || '' %>" maxlength="150" autocomplete="off" required>
      <label for="role">Rol</label>
      <select id="role" name="role">
        <option value="user">Usuario</option>
        <option value="admin" <%= values.role === 'admin' ? 'selected' : '' %>>Administrador</option>
      </select>
      <label for="password">Contraseña inicial</label>
      <input id="password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required>
      <button type="submit" class="btn btn-primary btn-block">Añadir</button>
    </form>
  </details>
</div>

<div class="box table-wrap">
  <table data-sortable>
    <thead>
      <tr><th scope="col" data-sort>Nombre</th><th scope="col" data-sort>Email</th><th scope="col" class="hide-sm" data-sort>Organización</th></tr>
    </thead>
    <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <th scope="row" data-value="<%= u.name %>"><%= u.name %><% if (u.role === 'admin') { %> <span class="badge">Admin</span><% } %></th>
          <td><%= u.email %></td>
          <td class="hide-sm"><%= u.organization %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/foot') %>
