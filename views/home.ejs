<%- include('partials/head') %>
<%# Textos en locales/*.json (home.*). %>
<section class="hero" aria-labelledby="t-hero">
  <a class="pill rise" href="#proposito"><span class="pill-dot" aria-hidden="true"></span><%= t('home.pill') %><%- icon('next') %></a>
  <h1 id="t-hero" class="hero-title"><span class="word">RUTF</span><span class="word word-2"><em>inder</em></span></h1>
  <p class="hero-sub rise"><%= t('home.sub') %></p>
  <form class="search rise" action="/buscar" method="get" role="search">
    <label class="sr-only" for="q"><%= t('home.searchLabel') %></label>
    <input id="q" name="q" type="search" placeholder="<%= t('home.placeholder') %>" maxlength="100" autocomplete="off" required>
    <button class="btn btn-primary" type="submit"><%= t('home.searchBtn') %></button>
  </form>
  <p class="try rise" aria-hidden="true"><%- icon('up') %><%= t('home.hint') %></p>
  <%# Cómo funciona: tres ilustraciones al estilo de las instrucciones de un sobre de RUTF. %>
  <ol class="how rise" aria-label="<%= t('home.howLabel') %>">
    <% t('home.steps').forEach((step, i) => { %>
      <li><img class="how-ico" src="/images/rutfinder-step-<%= i + 1 %>B.png" width="222" height="222" alt="" decoding="async"><span class="how-label"><span aria-hidden="true"><%= i + 1 %>. </span><%= step %></span></li>
    <% }) %>
  </ol>
</section>

<section class="section-wrap" id="proposito" aria-labelledby="t-proposito">
  <div class="section-head reveal">
    <h2 id="t-proposito"><%= t('home.sectionTitle') %></h2>
    <p><%= t('home.sectionText') %></p>
  </div>
  <%# Tres tarjetas altas: icono arriba, una pieza de interfaz que ilustra la idea en medio (decorativa) y título y texto abajo. %>
  <div class="features">
    <article class="fcard reveal">
      <span class="fcard-logo"><%- icon('swap') %></span>
      <div class="fcard-art" aria-hidden="true">
        <div class="art-code">
          <p class="art-code-head">RUTF A <span>⇄</span> RUTF B</p>
          <% ['nutrition', 'production', 'impact', 'evidence'].forEach((g) => { %><p><span class="art-check">✓</span><%= t(`groups.${g}`) %></p><% }) %>
        </div>
      </div>
      <div class="fcard-text"><h3><%= t('home.f1Title') %></h3><p><%= t('home.f1Text') %></p></div>
    </article>

    <article class="fcard reveal">
      <span class="fcard-logo"><%- icon('link') %></span>
      <div class="fcard-art" aria-hidden="true">
        <div class="art-stack">
          <p class="art-pill"><%- icon('globe') %><%- icon('evidence') %><span><%= t('home.mock.sources') %></span><%- icon('down') %></p>
          <ul class="art-list">
            <li><%- icon('feed') %><span><%= t('home.mock.src1') %></span><i class="art-toggle"></i></li>
            <li class="on"><%- icon('evidence') %><span><%= t('home.mock.src2') %></span><i class="art-toggle"></i></li>
            <li><%- icon('production') %><span><%= t('home.mock.src3') %></span><i class="art-toggle"></i></li>
            <li><%- icon('impact') %><span><%= t('groups.impact') %></span><em><%= t('noData') %></em></li>
          </ul>
        </div>
      </div>
      <div class="fcard-text"><h3><%= t('home.f2Title') %></h3><p><%= t('home.f2Text') %></p></div>
    </article>

    <article class="fcard reveal">
      <span class="fcard-logo"><%- icon('users') %></span>
      <div class="fcard-art" aria-hidden="true">
        <div class="art-stack art-stack-wide">
          <p class="art-input"><%- icon('plus') %><span><%= t('signup.organization') %>…</span></p>
          <ul class="art-menu">
            <li><%- icon('users') %><%= t('home.mock.org1') %></li>
            <li><%- icon('nutrition') %><%= t('home.mock.org2') %></li>
            <li class="on"><%- icon('general') %><%= t('home.mock.org3') %></li>
            <li class="art-sep"></li>
            <li><%- icon('check') %><%= t('signup.why2Title') %></li>
          </ul>
        </div>
      </div>
      <div class="fcard-text"><h3><%= t('home.f3Title') %></h3><p><%= t('home.f3Text') %></p></div>
    </article>

    <%# Tarjeta ancha: el semáforo de normas (standards.js). Normas en texto, sin logos: sus emblemas no se pueden usar sin permiso. %>
    <article class="fcard fcard-wide reveal">
      <div class="fcard-main">
        <span class="fcard-logo"><%- icon('standards') %></span>
        <div class="fcard-text"><h3><%= t('home.f4Title') %></h3><p><%= t('home.f4Text') %></p></div>
        <ul class="norm-list" aria-label="<%= t('home.f4NormsLabel') %>">
          <% t('home.f4Norms').forEach((n) => { %><li><%- icon('evidence') %><%= n %></li><% }) %>
        </ul>
        <p class="fcard-more"><a class="link" href="/normas"><%= t('home.f4Link') %></a><%- icon('next') %></p>
        <p class="fcard-note"><%= t('home.f4Note') %></p>
      </div>
      <div class="fcard-art" aria-hidden="true">
        <div class="art-std">
          <div class="art-std-tile">
            <p><%= t('standards.groups.composition') %></p>
            <p class="art-std-value"><%= t('standards.inRange', { n: 7, total: 9 }) %></p>
            <span class="std-bar"><i class="b-in" style="flex: 7"></i><i class="b-out" style="flex: 1"></i><i class="b-none" style="flex: 1"></i></span>
          </div>
          <ul class="art-list art-std-list">
            <% [['energy', `${numd(545)} kcal`, 'in', 'check'], ['protein', `${numd(10.9, 1)} %`, 'in', 'check'], ['n3', `${numd(55)} mg`, 'out', 'x', 'low'], ['moisture', '—', 'none', 'minus']].forEach(([key, value, tone, ico, status]) => { %>
              <li><span><%= t(`standards.params.${key}`) %></span><b><%= value %></b><span class="std-chip std-<%= tone %>"><%- icon(ico) %><%= t(`standards.status.${status || tone}`) %></span></li>
            <% }) %>
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section-wrap" id="contacto" aria-labelledby="t-contacto">
  <div class="module contact reveal">
    <div class="contact-text">
      <span class="tint tint-red"><%- icon('mail') %></span>
      <h2 id="t-contacto"><%= t('home.contactTitle') %></h2>
      <p><%= t('home.contactText') %></p>
    </div>
    <% if (contact.sent) { %>
      <div class="contact-done" role="status">
        <span class="contact-check"><%- icon('check') %></span>
        <h3><%= t('home.sentTitle') %></h3>
        <p class="muted"><%= t('home.sentText') %></p>
      </div>
    <% } else { %>
      <form method="post" action="/contacto#contacto" class="contact-form">
        <% if (contact.error) { %><div class="flash flash-error" role="alert"><%= contact.error %></div><% } %>
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <div class="trap" aria-hidden="true"><label for="web">Web</label><input id="web" name="web" type="text" tabindex="-1" autocomplete="off"></div>
        <div class="contact-row">
          <div>
            <label for="c-name"><%= t('home.name') %></label>
            <input id="c-name" name="name" type="text" value="<%= contact.values.name || '' %>" maxlength="100" autocomplete="name" required>
          </div>
          <div>
            <label for="c-email"><%= t('home.email') %></label>
            <input id="c-email" name="email" type="email" value="<%= contact.values.email || '' %>" maxlength="254" autocomplete="email" required>
          </div>
        </div>
        <label for="c-message"><%= t('home.message') %></label>
        <textarea id="c-message" name="message" rows="5" maxlength="4000" required><%= contact.values.message || '' %></textarea>
        <button type="submit" class="btn btn-primary btn-block"><%= t('home.send') %></button>
        <p class="form-note"><%= t('home.privacyNote') %> <a class="link" href="/privacidad"><%= t('legalPages.readMore') %></a></p>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/foot') %>
