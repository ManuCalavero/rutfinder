<%- include('partials/head') %>
<section class="narrow">
  <h1 class="center">Iniciar sesión</h1>
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" class="box box-pad form">
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" required autofocus>
    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
  </form>
  <p class="box box-pad center">¿No tienes cuenta? <a href="/registro">Solicita acceso</a>.</p>
</section>
<%- include('partials/foot') %>
