<%- include('partials/head') %>
<%# Iniciar sesión: página suelta en blanco (bare: true en server.js), solo logo e idioma arriba. Textos: login.* %>
<section class="auth">
  <h1><%= t('login.heading') %></h1>
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label for="email"><%= t('login.email') %></label>
    <input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" required autofocus>
    <label for="password"><%= t('login.password') %></label>
    <div class="pw">
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button class="pw-toggle" type="button" aria-controls="password" aria-pressed="false" aria-label="<%= t('signup.show') %>" data-show="<%= t('signup.show') %>" data-hide="<%= t('signup.hide') %>" hidden><%- icon('eye') %><%- icon('hidden') %></button>
    </div>
    <button type="submit" class="btn btn-primary btn-block"><%= t('login.submit') %></button>
  </form>
  <p class="auth-alt"><%= t('login.new') %> <a class="link" href="/registro"><%= t('login.newLink') %></a></p>
</section>
<%- include('partials/foot') %>
