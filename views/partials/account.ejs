<% const initials = user.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase(); %>
<details class="dropdown account">
  <summary aria-label="<%= t('account.label', { name: user.name }) %>"><span class="avatar" aria-hidden="true"><%= initials %></span><span class="account-name"><%= user.name %><small><%= user.email %></small></span><%- icon('down') %></summary>
  <div class="dropdown-panel menu">
    <p class="menu-who"><strong><%= user.name %></strong><span><%= user.email %></span></p>
    <% if (user.role === 'admin') { %><a href="/admin/cuenta"><%= t('account.mine') %></a><% } %>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <button type="submit"><%= t('account.logout') %></button>
    </form>
  </div>
</details>
