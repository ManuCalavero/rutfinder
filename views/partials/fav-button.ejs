<form method="post" action="/favoritos/<%= product.id %>" class="fav">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <input type="hidden" name="volver" value="<%= here %><%= locals.anchor ? `#${locals.anchor}` : '' %>">
  <button type="submit" class="star" aria-pressed="<%= product.favorite %>" aria-label="<%= t('fav.label', { name: product.name }) %>" title="<%= t(product.favorite ? 'fav.remove' : 'fav.add') %>"><%- icon('star') %></button>
</form>
