<%- include('partials/head') %>
<% const admin = user.role === 'admin'; %>
<a class="back" href="<%= admin ? '/admin/productos' : '/productos' %>"><%- icon('back') %> <%= t('product.back') %></a>

<header class="product-head">
  <div>
    <h1><%= product.name %></h1>
    <% if (badges.length || product.hidden) { %>
      <p class="badges">
        <% if (product.hidden) { %><span class="badge badge-red"><%= t('product.hidden') %></span><% } %>
        <% badges.forEach((b) => { %><span class="badge badge-<%= b.tone %>"><%- icon(b.icon) %><%= b.text %></span><% }) %>
      </p>
    <% } %>
  </div>
  <div class="actions">
    <% if (source) { %><a class="btn" href="<%= source %>" target="_blank" rel="noopener noreferrer nofollow"><%- icon('external') %> <%= t('product.source') %></a><% } %>
    <% if (admin) { %>
      <a class="btn btn-primary" href="/admin/productos/<%= product.id %>/editar"><%= t('product.edit') %></a>
    <% } else { %>
      <a class="btn" href="/comparar?a=<%= product.id %>"><%- icon('swap') %> <%= t('product.compare') %></a>
      <%- include('partials/fav-button', { product }) %>
    <% } %>
  </div>
</header>

<% if (!groups.length) { %>
  <div class="box blankslate"><p><%= t('noData') %>.</p></div>
<% } else { %>
<div class="product-layout">
  <div class="sections">
    <% groups.forEach((g) => { %>
      <section class="box section" id="<%= g.id %>" aria-labelledby="t-<%= g.id %>">
        <h2 id="t-<%= g.id %>"><%- icon(g.id) %><%= g.title %></h2>
        <% if (g.filled) { %>
          <div class="fields">
            <% g.items.filter((i) => i.value).forEach((i) => { const { value, estimated: est } = readEstimated(i.value); const rows = kvRows(value); %>
              <div class="field<%= i.half ? ' field-half' : '' %>">
                <h3><%= i.label %><% if (est) { %> <span class="badge"><%= t('product.estimated') %></span><% } %></h3>
                <% if (rows) { %>
                  <table class="kv"><tbody>
                    <% rows.forEach(([k, v]) => { %><tr><th scope="row"><%= k %></th><td><%- linkify(v) %></td></tr><% }) %>
                  </tbody></table>
                <% } else { %>
                  <div class="field-value"><%- linkify(value) %></div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (g.empty.length) { %><p class="empty-note"><%= t('noData') %>: <%= g.empty.join(', ') %></p><% } %>
      </section>
    <% }) %>
  </div>
  <%- include('partials/toc', { groups }) %>
</div>
<% } %>
<%- include('partials/foot') %>
