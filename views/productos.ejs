<%- include('partials/head') %>
<% const filtered = search || country; const base = onlyFavorites ? '/favoritos' : '/productos'; %>
<% const meta = (p) => [typeLabel(p.type), p.location && countries_text(p.location)].filter(Boolean).join(' · '); %>
<div class="page-head">
  <h1><%= title %></h1>
  <% if (!onlyFavorites) { %>
    <details class="dropdown" <%= openSuggest ? 'open' : '' %>>
      <summary class="btn"><%= t('products.suggest') %></summary>
      <form method="post" action="/sugerencias" class="dropdown-panel">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <label for="s-url"><%= t('products.link') %></label>
        <input id="s-url" name="url" type="url" maxlength="500" autocomplete="off">
        <label for="s-name"><%= t('products.name') %></label>
        <input id="s-name" name="name" type="text" maxlength="300" autocomplete="off">
        <label for="s-producer"><%= t('products.producer') %></label>
        <input id="s-producer" name="producer" type="text" maxlength="150" autocomplete="off">
        <label for="s-country"><%= t('products.country') %></label>
        <input id="s-country" name="country" type="text" maxlength="100" autocomplete="off">
        <label for="s-notes"><%= t('products.notes') %></label>
        <textarea id="s-notes" name="notes" rows="3" maxlength="2000"></textarea>
        <button type="submit" class="btn btn-primary btn-block"><%= t('products.send') %></button>
      </form>
    </details>
  <% } %>
</div>

<form method="get" action="<%= base %>" class="filters" role="search">
  <input name="q" type="search" value="<%= search %>" maxlength="100" placeholder="<%= t('products.search') %>" aria-label="<%= t('products.search') %>">
  <select name="pais" aria-label="<%= t('products.countryLabel') %>">
    <option value=""><%= t('products.allCountries') %></option>
    <% countries.forEach((c) => { %><option value="<%= c %>" <%= c === country ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <button type="submit" class="btn"><%= t('products.filter') %></button>
  <% if (filtered) { %><a class="link" href="<%= base %>"><%= t('products.clear') %></a><% } %>
  <% if (products.length) { %>
    <span class="views">
      <button type="button" class="view-toggle" data-toggle-view="grid" aria-label="<%= t('products.cards') %>" title="<%= t('products.cards') %>" hidden><%- icon('grid') %></button>
      <button type="button" class="view-toggle" data-toggle-view="table" aria-label="<%= t('products.table') %>" title="<%= t('products.table') %>" hidden><%- icon('list') %></button>
      <button type="button" class="view-toggle" data-toggle-view="map" aria-label="<%= t('products.map') %>" title="<%= t('products.map') %>" hidden><%- icon('map') %></button>
    </span>
  <% } %>
</form>

<% if (!products.length) { %>
  <div class="box blankslate">
    <% if (filtered) { %>
      <p><%= t('products.noMatch') %></p>
    <% } else if (onlyFavorites) { %>
      <p><%- t('products.favEmpty', { link: `<a class="link" href="/productos">${esc(t('products.favEmptyLink'))}</a>` }) %></p>
    <% } else { %>
      <p><%= t('products.empty') %></p>
    <% } %>
  </div>
<% } else { %>
  <div class="products-view cards" data-view="grid">
    <% products.forEach((p) => { %>
      <article class="card" id="p<%= p.id %>">
        <h2><a href="/productos/<%= p.id %>"><%= p.name %></a></h2>
        <% if (p.producer) { %><p class="card-producer"><%= p.producer %></p><% } %>
        <% if (meta(p)) { %><p class="card-meta"><%= meta(p) %></p><% } %>
        <%- include('partials/fav-button', { product: p, anchor: `p${p.id}` }) %>
      </article>
    <% }) %>
  </div>

  <div class="products-view box table-wrap" data-view="table" hidden>
    <table data-sortable>
      <thead>
        <tr><th scope="col" data-sort aria-sort="ascending"><%= t('products.name') %></th><th scope="col" data-sort><%= t('products.producer') %></th><th scope="col" class="hide-sm" data-sort><%= t('products.type') %></th><th scope="col" class="hide-sm" data-sort><%= t('products.country') %></th><th scope="col"><span class="sr-only"><%= t('products.favorite') %></span></th></tr>
      </thead>
      <tbody>
        <% products.forEach((p) => { %>
          <tr id="t<%= p.id %>">
            <th scope="row"><a href="/productos/<%= p.id %>"><%= p.name %></a></th>
            <td class="cell-clip" data-value="<%= p.producer || '' %>"><%= p.producer || t('noData') %></td>
            <td class="hide-sm" data-value="<%= typeLabel(p.type) %>"><%= typeLabel(p.type) || t('noData') %></td>
            <td class="hide-sm" data-value="<%= p.location ? countries_text(p.location) : '' %>"><%= countries_text(p.location) %></td>
            <td class="cell-actions"><%- include('partials/fav-button', { product: p, anchor: `t${p.id}` }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <%# Mapa: un marcador por país (más grande cuantos más productos) que lleva a su lista de productos, debajo del mapa. %>
  <% const byId = new Map(products.map((p) => [p.id, p]));
     const onMap = places.filter((c) => c.feature && c.feature.center);
     const maxN = Math.max(1, ...places.map((c) => c.n));
     const placeId = (c) => 'pais-' + c.label.normalize('NFD').replace(/[^\w]+/g, '-').toLowerCase(); %>
  <div class="products-view map-view" data-view="map" hidden>
    <div class="box map-box">
      <svg class="world" viewBox="0 0 960 424" role="img" aria-label="<%= t('products.mapLabel') %>">
        <% const has = new Set(onMap.map((c) => c.feature.name)); %>
        <% world.forEach((f) => { %><path d="<%= f.d %>"<%- has.has(f.name) ? ' class="has"' : '' %>></path><% }) %>
        <% onMap.slice().reverse().forEach((c) => { const r = 5 + 7 * Math.sqrt(c.n / maxN); %>
          <a class="pin" href="#<%= placeId(c) %>">
            <title><%= c.label %>: <%= c.n %></title>
            <circle class="pin-halo" cx="<%= c.feature.center.x %>" cy="<%= c.feature.center.y %>" r="<%= (r + 5).toFixed(1) %>"/>
            <circle class="pin-dot" cx="<%= c.feature.center.x %>" cy="<%= c.feature.center.y %>" r="<%= r.toFixed(1) %>"/>
          </a>
        <% }) %>
      </svg>
    </div>
    <div class="places">
      <% places.forEach((c) => { %>
        <section class="place" id="<%= placeId(c) %>">
          <h2><%= c.label %> <span class="place-n"><%= c.n %></span><% if (!c.feature) { %> <span class="place-note"><%= t('products.noPlace') %></span><% } %></h2>
          <ul>
            <% c.ids.map((id) => byId.get(id)).filter(Boolean).forEach((p) => { %>
              <li><a href="/productos/<%= p.id %>"><%= p.name %></a><% if (p.producer) { %> <span class="muted">· <%= p.producer %></span><% } %></li>
            <% }) %>
          </ul>
        </section>
      <% }) %>
    </div>
  </div>
<% } %>
<%- include('partials/foot') %>
