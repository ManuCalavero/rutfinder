<%- include('partials/head') %>
<% const filtered = search || country; const base = onlyFavorites ? '/favoritos' : '/productos'; %>
<div class="page-head">
  <h1><%= title %></h1>
  <div class="page-head-actions">
    <% if (products && products.length) { %>
      <button class="view-toggle" data-toggle-view="grid" title="Vista de cards">
        <%- icon('grid') %>
      </button>
      <button class="view-toggle" data-toggle-view="table" title="Vista de tabla">
        <%- icon('table') %>
      </button>
    <% } %>
    <% if (!onlyFavorites) { %>
    <details class="dropdown" <%= openSuggest ? 'open' : '' %>>
      <summary class="btn btn-primary">Sugerir producto</summary>
    <form method="post" action="/sugerencias" class="dropdown-panel form">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <h2>Sugerir un producto</h2>
      <p class="hint">¿Falta algún RUTF? Pega un enlace donde aparezca o rellena lo que sepas. Un administrador lo revisará.</p>
      <label for="s-url">Enlace al producto</label>
      <input id="s-url" name="url" type="url" maxlength="500" placeholder="https://…" autocomplete="off">
      <p class="divider"><span>o rellena los datos</span></p>
      <label for="s-name">Nombre del producto</label>
      <input id="s-name" name="name" type="text" maxlength="300" autocomplete="off">
      <label for="s-producer">Productor</label>
      <input id="s-producer" name="producer" type="text" maxlength="150" autocomplete="off">
      <label for="s-country">País de producción</label>
      <input id="s-country" name="country" type="text" maxlength="100" autocomplete="off">
      <label for="s-notes">Notas</label>
      <textarea id="s-notes" name="notes" rows="3" maxlength="2000" placeholder="Composición, coste, fuente… lo que sepas"></textarea>
      <button type="submit" class="btn btn-primary btn-block">Enviar sugerencia</button>
    </form>
  </details>
    <% } %>
  </div>
</div>

<form method="get" action="<%= base %>" class="filters" role="search">
  <div>
    <label for="q">Buscar</label>
    <input id="q" name="q" type="search" value="<%= search %>" maxlength="100" placeholder="Nombre, productor, ingrediente…">
  </div>
  <div>
    <label for="pais">País de producción</label>
    <select id="pais" name="pais">
      <option value="">Todos los países</option>
      <% countries.forEach((c) => { %><option value="<%= c %>" <%= c === country ? 'selected' : '' %>><%= c %></option><% }) %>
    </select>
  </div>
  <button type="submit" class="btn">Filtrar</button>
  <% if (filtered) { %><a href="<%= base %>">Limpiar filtros</a><% } %>
</form>

<% if (!products.length) { %>
  <div class="box blankslate">
    <% if (filtered) { %>
      <h2>Ningún producto coincide con tu búsqueda</h2>
      <p><a href="<%= base %>">Limpiar filtros</a></p>
    <% } else if (onlyFavorites) { %>
      <h2>Aún no tienes favoritos</h2>
      <p>Guarda productos desde el <a href="/productos">catálogo de productos</a> para tenerlos a mano aquí.</p>
    <% } else { %>
      <h2>Todavía no hay productos</h2>
      <p>Cuando el administrador publique productos aparecerán aquí.</p>
    <% } %>
  </div>
<% } else { %>
  <p class="muted" role="status"><%= products.length %> <%= products.length === 1 ? 'producto' : 'productos' %></p>

  <div class="products-view" data-view="grid">
    <div class="products-grid">
      <% products.forEach((product) => { %>
        <article class="product-card">
          <div class="product-card-inner">
            <div class="product-card-head">
              <h3><a href="/productos/<%= product.id %>"><%= product.name %></a></h3>
              <% if (product.producer) { %><p class="product-card-producer"><%= product.producer %></p><% } %>
            </div>
            <div class="product-card-badges">
              <% const tb = typeBadge(product.type); %>
              <% if (tb) { %><span class="badge badge-<%= tb.tone %>"><%= tb.text %></span><% } %>
            </div>
            <% if (product.location) { %>
              <p class="product-card-location"><%= countries_text(product.location) %></p>
            <% } %>
          </div>
          <div class="product-card-action">
            <%- include('partials/fav-button', { product }) %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>

  <div class="products-view" data-view="table" hidden>
    <div class="box table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Productor</th>
            <th scope="col" class="hide-sm">Tipo de producción</th>
            <th scope="col">País de producción</th>
            <th scope="col"><span class="sr-only">Favorito</span></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product) => { %>
            <tr>
              <th scope="row"><a href="/productos/<%= product.id %>"><%= product.name %></a></th>
              <td><%= product.producer || 'Sin datos' %></td>
              <td class="hide-sm"><% const tb = typeBadge(product.type); %><% if (tb) { %><span class="badge badge-<%= tb.tone %>"><%= tb.text %></span><% } else { %><span class="muted">Sin datos</span><% } %></td>
              <td><%= countries_text(product.location) %></td>
              <td class="cell-actions"><%- include('partials/fav-button', { product }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
<%- include('partials/foot') %>
