<%- include('partials/head') %>
<%# Registro, en un único bloque como el de «Hablemos»: resultado y motivos a la izquierda, formulario a la derecha.
    Si se llega desde el buscador de la portada, arriba solo se dice cuántos productos coinciden. Textos: signup.* %>
<% const found = search && count > 0; %>
<div class="access">
  <div class="module access-grid">
    <div class="access-main">
      <%# Un solo panel, tan alto como el formulario: arriba el resultado y la invitación a registrarse; abajo, por qué hay que registrarse. %>
      <div class="access-panel">
        <div class="access-top">
          <%# El número es el titular: coincidencias de la búsqueda o, sin búsqueda, el total del directorio. %>
          <h1 class="access-count rise">
            <span class="count-n<%= search && !found ? ' is-zero' : '' %>"><%= num(search ? count : total) %></span>
            <span class="count-label"><%= search ? t('signup.matches', { count, q: search }) : t('signup.totalLabel') %></span>
          </h1>
          <% if (found) { %>
            <p class="count-sub"><%= t('signup.ofTotal', { n: num(total) }) %></p>
          <% } else if (search) { %>
            <p class="count-sub"><%= t('signup.noneTotal', { n: num(total) }) %> <%= t('signup.noneHelp') %> <a class="link" href="/#contacto"><%= t('signup.noneLink') %></a></p>
          <% } %>
          <%# La flecha apunta al formulario: a la derecha en escritorio, hacia abajo en móvil. %>
          <p class="access-cta"><%- icon('arrow') %><span><%= found ? t('signup.askFound', { n: count }) : t('signup.ask') %></span></p>
          <p class="access-free"><%= t('signup.free') %></p>
        </div>
        <section class="access-why" aria-labelledby="t-why">
          <h2 id="t-why"><%= t('signup.whyTitle') %></h2>
          <ul class="why">
            <li><span class="tint tint-mint"><%- icon('users') %></span><div><h3><%= t('signup.why1Title') %></h3><p><%= t('signup.why1Text') %></p></div></li>
            <li><span class="tint tint-sun"><%- icon('evidence') %></span><div><h3><%= t('signup.why2Title') %></h3><p><%= t('signup.why2Text') %></p></div></li>
            <li><span class="tint tint-lilac"><%- icon('mail') %></span><div><h3><%= t('signup.why3Title') %></h3><p><%= t(found ? 'signup.why3TextFound' : 'signup.why3Text') %></p></div></li>
          </ul>
        </section>
      </div>
    </div>

    <div class="access-form">
      <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
      <%# Sin JavaScript valida el navegador (required, pattern, minlength). Con app.js: mensajes bajo cada campo y botón de ver/ocultar. %>
      <form method="post" action="/registro" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <% if (search) { %><input type="hidden" name="busqueda" value="<%= search %>"><% } %>
        <div class="field">
          <label for="name"><%= t('signup.name') %></label>
          <input id="name" name="name" type="text" value="<%= values.name || '' %>" maxlength="100" autocomplete="name" required aria-describedby="name-error" data-error="<%= t('errors.name') %>">
          <p class="field-error" id="name-error" hidden></p>
        </div>
        <div class="field">
          <label for="email"><%= t('signup.email') %></label>
          <input id="email" name="email" type="email" value="<%= values.email || '' %>" maxlength="254" autocomplete="email" required pattern="[^\s@]+@[^\s@]+\.[^\s@]+" aria-describedby="email-error" data-error="<%= t('errors.email') %>">
          <p class="field-error" id="email-error" hidden></p>
        </div>
        <div class="field">
          <label for="organization"><%= t('signup.organization') %></label>
          <input id="organization" name="organization" type="text" value="<%= values.organization || '' %>" maxlength="150" autocomplete="organization" required aria-describedby="organization-error" data-error="<%= t('errors.organization') %>">
          <p class="field-error" id="organization-error" hidden></p>
        </div>
        <div class="field">
          <label for="password"><%= t('signup.password') %></label>
          <div class="pw">
            <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required aria-describedby="password-hint password-error" data-error="<%= t('errors.password') %>">
            <button class="pw-toggle" type="button" aria-controls="password" aria-pressed="false" aria-label="<%= t('signup.show') %>" data-show="<%= t('signup.show') %>" data-hide="<%= t('signup.hide') %>" hidden><%- icon('eye') %><%- icon('hidden') %></button>
          </div>
          <p class="field-hint" id="password-hint"><%= t('signup.passwordHint') %></p>
          <p class="field-error" id="password-error" hidden></p>
        </div>
        <button type="submit" class="btn btn-primary btn-block"><%= t('signup.submit') %></button>
        <p class="secure"><%- icon('lock') %><span><strong><%= t('signup.secureTitle') %></strong> <%= t('signup.secureText') %></span></p>
        <p class="form-note"><%= t('signup.privacyNote') %> <a class="link" href="/privacidad"><%= t('legalPages.readMore') %></a></p>
      </form>
      <p class="alt"><%= t('signup.haveAccount') %> <a class="link" href="/login"><%= t('nav.login') %></a></p>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
